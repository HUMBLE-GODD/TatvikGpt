# ==============================================================================
# Azure AI Foundry & Azure Blob Storage Chatbot Configuration (Template)
# ==============================================================================

# --- Azure AI Foundry Inference ---
# Your Azure API Key (from Azure AI Foundry Portal -> Endpoint & Keys)
AZURE_AI_API_KEY=

# Project or Service Endpoint URL
# E.g. https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses

# Model Deployment Name (e.g. 'gpt-5.4-nano', 'gpt-5.4-mini', 'gpt-4o')
AZURE_AI_DEPLOYMENT_NAME=gpt-5.4-nano

# API Version (defaults to latest supported preview)
AZURE_AI_API_VERSION=2024-08-01-preview

# Endpoint Type ('auto', 'azure_openai', or 'foundry_serverless')
AZURE_AI_ENDPOINT_TYPE=auto

# Assistant System Prompt & Model Parameters
SYSTEM_PROMPT=You are an intelligent, helpful, and concise AI assistant powered by Azure AI Foundry.
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024

# ==============================================================================
# Azure Blob Storage Configuration (Chat History Persistence)
# ==============================================================================
# Option 1: Full Connection String (Azure Portal -> Storage account -> Access keys)
AZURE_STORAGE_CONNECTION_STRING=

# Option 2: Account Name & Key (Alternative to Connection String)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Container name (auto-created by the app if it does not exist)
AZURE_STORAGE_CONTAINER_NAME=chat-history

# Virtual folder prefix inside the container
AZURE_STORAGE_BLOB_PREFIX=chat_history/
